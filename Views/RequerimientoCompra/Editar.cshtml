@model AppWeb.Models.RequerimientoCompra
@{
    ViewData["Title"] = "Editar Requerimiento de Compra";
    Layout = "_LayoutDashboard";
    var productos = ViewBag.Productos as IEnumerable<AppWeb.Models.Producto> ?? Enumerable.Empty<AppWeb.Models.Producto>();
}

<div id="viewEditarRequerimiento" class="view-container active">
    <div class="view-header" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
        <div>
            <h2>Editar Requerimiento #@Model.idRequerimiento</h2>
            <div class="breadcrumb">
                <a asp-controller="Home" asp-action="Index" style="color:inherit; text-decoration:none;">Inicio</a> &gt;
                <a asp-controller="RequerimientoCompra" asp-action="Index" style="color:inherit; text-decoration:none;">Requerimientos de Compra</a> &gt;
                <span>Editar</span>
            </div>
        </div>
        <a asp-controller="RequerimientoCompra" asp-action="Index"
           style="background:#6c757d; color:#fff; padding:8px 16px; border-radius:8px; text-decoration:none; font-weight:500; display:inline-flex; align-items:center; gap:8px;">
            <i class="fas fa-arrow-left"></i> Volver
        </a>
    </div>

    <div class="table-wrapper" style="max-width: 700px; padding: 24px;">
        <form asp-controller="RequerimientoCompra" asp-action="Editar" method="post" autocomplete="off">
            <input type="hidden" asp-for="idRequerimiento" />
            <input type="hidden" asp-for="estado" />
            <input type="hidden" asp-for="idUsuario" />
            <input type="hidden" asp-for="fechaCreacion" />
            <div asp-validation-summary="All" style="color:#DC3545; margin-bottom:15px;"></div>

            <div style="margin-bottom: 14px;">
                <label asp-for="idProducto" style="display:block; font-weight:500; margin-bottom:6px;">Producto</label>
                <select asp-for="idProducto"
                        style="width:100%; padding:10px 12px; border:1px solid #ced4da; border-radius:6px; box-sizing:border-box; background:#fff;">
                    <option value="0">Seleccione un producto...</option>
                    @foreach (var p in productos)
                    {
                        <option value="@p.idProducto">@p.nombre (Stock actual: @p.stockActual / Mín: @p.stockMinimo)</option>
                    }
                </select>
            </div>

            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:14px; margin-bottom:14px;">
                <div>
                    <label asp-for="cantidadSugerida" style="display:block; font-weight:500; margin-bottom:6px;">Cantidad Sugerida</label>
                    <input type="number" asp-for="cantidadSugerida" min="0"
                           style="width:100%; padding:10px 12px; border:1px solid #ced4da; border-radius:6px; box-sizing:border-box;" />
                </div>
                <div>
                    <label asp-for="cantidadRequerida" style="display:block; font-weight:500; margin-bottom:6px;">Cantidad Requerida</label>
                    <input type="number" asp-for="cantidadRequerida" min="1"
                           style="width:100%; padding:10px 12px; border:1px solid #ced4da; border-radius:6px; box-sizing:border-box;" />
                </div>
            </div>

            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:14px; margin-bottom:14px;">
                <div>
                    <label asp-for="fechaRequerida" style="display:block; font-weight:500; margin-bottom:6px;">Fecha Requerida</label>
                    <input type="date" asp-for="fechaRequerida"
                           style="width:100%; padding:10px 12px; border:1px solid #ced4da; border-radius:6px; box-sizing:border-box;" />
                </div>
                <div>
                    <label asp-for="prioridad" style="display:block; font-weight:500; margin-bottom:6px;">Prioridad</label>
                    <select asp-for="prioridad"
                            style="width:100%; padding:10px 12px; border:1px solid #ced4da; border-radius:6px; box-sizing:border-box; background:#fff;">
                        <option value="Baja">Baja</option>
                        <option value="Media">Media</option>
                        <option value="Alta">Alta</option>
                    </select>
                </div>
            </div>

            <div style="margin-bottom: 20px;">
                <label asp-for="motivo" style="display:block; font-weight:500; margin-bottom:6px;">Motivo / Observación (Opcional)</label>
                <textarea asp-for="motivo" rows="3"
                          style="width:100%; padding:10px 12px; border:1px solid #ced4da; border-radius:6px; box-sizing:border-box; font-family:inherit;"></textarea>
            </div>

            <div style="display:flex; gap:10px; justify-content:flex-end;">
                <a asp-controller="RequerimientoCompra" asp-action="Index"
                   style="padding:10px 18px; border-radius:6px; text-decoration:none; background:#e2e6ea; color:#333; font-weight:500;">
                    Cancelar
                </a>
                <button type="submit"
                        style="padding:10px 20px; border:none; border-radius:6px; background:#304D8A; color:#fff; font-weight:500; cursor:pointer;">
                    <i class="fas fa-save"></i> Actualizar Requerimiento
                </button>
            </div>
        </form>
    </div>
</div>

