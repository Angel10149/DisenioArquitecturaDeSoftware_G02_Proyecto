@model IEnumerable<AppWeb.Models.RequerimientoCompra>
@{
    ViewData["Title"] = "Requerimientos de Compra";
    Layout = "_LayoutDashboard";
    string? estadoSel = ViewBag.Estado as string;
}

<div id="viewRequerimientos" class="view-container active">
    <div class="view-header" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
        <div>
            <h2>Requerimientos de Compra</h2>
            <div class="breadcrumb">
                <a asp-controller="Home" asp-action="Index" style="color:inherit; text-decoration:none;">Inicio</a> &gt;
                <span>Requerimientos de Compra</span>
            </div>
        </div>
        <a asp-controller="RequerimientoCompra" asp-action="Crear"
           style="background:#304D8A; color:#fff; padding:10px 18px; border-radius:8px; text-decoration:none; font-weight:500; display:inline-flex; align-items:center; gap:8px;">
            <i class="fas fa-plus"></i> Nuevo Requerimiento
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div style="margin-bottom: 15px; padding: 10px 15px; border-radius: 6px; background: #d4edda; color: #155724;">
            @TempData["Mensaje"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div style="margin-bottom: 15px; padding: 10px 15px; border-radius: 6px; background: #f8d7da; color: #721c24;">
            @TempData["Error"]
        </div>
    }

    <!-- TARJETAS DE MÉTRICAS -->
    <div class="metrics-row">
        <div class="metric-box">
            <span class="label">Total Requerimientos</span>
            <span class="value">@Model.Count()</span>
        </div>
        <div class="metric-box">
            <span class="label">Pendientes</span>
            <span class="value">@Model.Count(r => r.estado == "Pendiente")</span>
        </div>
        <div class="metric-box">
            <span class="label">Aprobados</span>
            <span class="value">@Model.Count(r => r.estado == "Aprobado")</span>
        </div>
        <div class="metric-box">
            <span class="label">Atendidos</span>
            <span class="value">@Model.Count(r => r.estado == "Atendido")</span>
        </div>
    </div>

    <!-- FILTROS Y BUSCADOR -->
    <form asp-controller="RequerimientoCompra" asp-action="Index" method="get" style="display:flex; gap:10px; margin-bottom:16px; flex-wrap:wrap; align-items:center;">
        <select name="estado" onchange="this.form.submit()"
                style="padding:9px 12px; border:1px solid #ced4da; border-radius:6px; background:#fff;">
            <option value="">Todos los Estados</option>
            <option value="Pendiente" selected="@(estadoSel == "Pendiente")">Pendiente</option>
            <option value="Aprobado" selected="@(estadoSel == "Aprobado")">Aprobado</option>
            <option value="Atendido" selected="@(estadoSel == "Atendido")">Atendido</option>
            <option value="Rechazado" selected="@(estadoSel == "Rechazado")">Rechazado</option>
        </select>

        <input type="text" name="buscar" value="@ViewBag.Buscar" placeholder="Buscar por producto, motivo o solicitante..."
               style="flex:1; min-width:240px; padding:9px 12px; border:1px solid #ced4da; border-radius:6px;" />

        <button type="submit" style="padding:9px 16px; border:none; border-radius:6px; background:#304D8A; color:#fff; cursor:pointer;">
            <i class="fas fa-search"></i> Buscar
        </button>

        @if (!string.IsNullOrWhiteSpace(ViewBag.Buscar as string) || !string.IsNullOrWhiteSpace(estadoSel))
        {
            <a asp-controller="RequerimientoCompra" asp-action="Index"
               style="padding:9px 16px; border-radius:6px; background:#e2e6ea; color:#333; text-decoration:none; display:inline-flex; align-items:center;">
                Limpiar
            </a>
        }
    </form>

    <!-- TABLA DE REQUERIMIENTOS -->
    <div class="table-wrapper">
        <table class="data-table" id="requerimientosTable">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Producto</th>
                    <th>Sugerida</th>
                    <th>Requerida</th>
                    <th>Fecha Requerida</th>
                    <th>Prioridad</th>
                    <th>Solicitante</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" style="text-align:center; padding:20px; color:#6c757d;">
                            No se encontraron requerimientos de compra.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var req in Model)
                    {
                        var colorEstado = req.estado switch
                        {
                            "Aprobado" => "#28A745",
                            "Atendido" => "#304D8A",
                            "Rechazado" => "#DC3545",
                            _ => "#FFC107"
                        };
                        var colorPrioridad = req.prioridad switch
                        {
                            "Alta" => "#DC3545",
                            "Baja" => "#6c757d",
                            _ => "#FFC107"
                        };
                        <tr>
                            <td>#@req.idRequerimiento</td>
                            <td>
                                <strong>@(req.producto?.nombre ?? "-")</strong>
                                @if (!string.IsNullOrWhiteSpace(req.motivo))
                                {
                                    <div style="font-size:0.82rem; color:#6c757d;">@req.motivo</div>
                                }
                            </td>
                            <td>@req.cantidadSugerida</td>
                            <td><strong>@req.cantidadRequerida</strong></td>
                            <td>@req.fechaRequerida.ToString("yyyy-MM-dd")</td>
                            <td><span style="color:@colorPrioridad; font-weight:600;">@req.prioridad</span></td>
                            <td>@(req.usuario?.nombreUsuario ?? "-")</td>
                            <td><span style="color:@colorEstado; font-weight:600;">@req.estado</span></td>
                            <td style="white-space:nowrap;">
                                @if (req.estado == "Pendiente")
                                {
                                    <a asp-controller="RequerimientoCompra" asp-action="Editar" asp-route-id="@req.idRequerimiento"
                                       style="padding:4px 10px; border-radius:4px; text-decoration:none; font-size:0.85rem; color:#fff; background:#304D8A; margin-right:4px; display:inline-block;">
                                        Editar
                                    </a>
                                    <form asp-controller="RequerimientoCompra" asp-action="CambiarEstado" method="post" style="display:inline;">
                                        <input type="hidden" name="id" value="@req.idRequerimiento" />
                                        <input type="hidden" name="nuevoEstado" value="Aprobado" />
                                        <button type="submit"
                                                style="padding:4px 10px; border:none; border-radius:4px; cursor:pointer; font-size:0.85rem; color:#fff; background:#28A745; margin-right:4px;"
                                                onclick="return confirm('¿Aprobar este requerimiento?');">
                                            Aprobar
                                        </button>
                                    </form>
                                    <form asp-controller="RequerimientoCompra" asp-action="CambiarEstado" method="post" style="display:inline;">
                                        <input type="hidden" name="id" value="@req.idRequerimiento" />
                                        <input type="hidden" name="nuevoEstado" value="Rechazado" />
                                        <button type="submit"
                                                style="padding:4px 10px; border:none; border-radius:4px; cursor:pointer; font-size:0.85rem; color:#fff; background:#DC3545;"
                                                onclick="return confirm('¿Rechazar este requerimiento?');">
                                            Rechazar
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span style="color:#6c757d; font-size:0.85rem;">Sin acciones</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

