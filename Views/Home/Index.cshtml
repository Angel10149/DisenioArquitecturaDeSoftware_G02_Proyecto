@model AppWeb.Controllers.DashboardVM
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_LayoutDashboard";
    var maxVentaDia = Model.VentasUltimos7Dias.Any() ? Math.Max(1m, Model.VentasUltimos7Dias.Max(d => d.Total)) : 1m;
    var coloresCat = new[] { "#304D8A", "#28A745", "#FFC107", "#DC3545", "#4A78C2" };
    var totalCatMes = Model.VentasPorCategoriaMes.Sum(c => c.Total);
    var gradienteParts = new List<string>();
    if (totalCatMes > 0)
    {
        decimal acumulado = 0m;
        for (int i = 0; i < Model.VentasPorCategoriaMes.Count; i++)
        {
            var pct = (Model.VentasPorCategoriaMes[i].Total / totalCatMes) * 100m;
            var inicioPct = acumulado;
            acumulado += pct;
            var color = coloresCat[i % coloresCat.Length];
            gradienteParts.Add($"{color} {inicioPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}% {acumulado.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%");
        }
    }
    var donutStyle = gradienteParts.Any()
        ? $"background: conic-gradient({string.Join(", ", gradienteParts)});"
        : "background: conic-gradient(#e2e6ea 0% 100%);";
}

<div id="viewDashboard" class="view-container active">
    <div class="welcome-row">
        <h2>Bienvenido, @(User.Identity?.Name ?? "Administrador")</h2>
        <p>Resumen general del sistema</p>
    </div>

    <!-- TARJETAS DE MÉTRICAS -->
    <div class="cards-row">
        <div class="metric-card card-ventas">
            <div class="info">
                <span class="label">Ventas de hoy</span>
                <span class="value">S/ @Model.VentasHoy.ToString("N2")</span>
            </div>
            <i class="fas fa-shopping-cart icon"></i>
        </div>
        <div class="metric-card card-inventario">
            <div class="info">
                <span class="label">Inventario</span>
                <span class="value">@Model.TotalProductosActivos productos</span>
            </div>
            <i class="fas fa-cube icon"></i>
        </div>
        <div class="metric-card card-caja">
            <div class="info">
                <span class="label">Caja hoy</span>
                <span class="value">S/ @Model.CajaHoy.ToString("N2")</span>
                <span class="sub">@Model.MovimientosCajaHoy movimientos</span>
            </div>
            <i class="fas fa-box icon"></i>
        </div>
        <div class="metric-card card-alertas">
            <div class="info">
                <span class="label">Alertas</span>
                <span class="value">@Model.AlertasStockBajo stock bajo</span>
            </div>
            <i class="fas fa-bell icon"></i>
        </div>
    </div>

    <!-- FILA DE GRÁFICOS Y STOCK BAJO -->
    <div class="row-two-col">
        <div class="chart-box">
            <h3>Ventas (últimos 7 días)</h3>
            <div class="chart-wrapper">
                <div class="chart-y-axis">
                    <span>S/ @maxVentaDia.ToString("N0")</span>
                    <span>S/ @((maxVentaDia * 0.66m).ToString("N0"))</span>
                    <span>S/ @((maxVentaDia * 0.33m).ToString("N0"))</span>
                    <span>S/ 0</span>
                </div>
                <div class="chart-bars" id="chartBars">
                    @foreach (var dia in Model.VentasUltimos7Dias)
                    {
                        var alturaPx = (int)Math.Round((dia.Total / maxVentaDia) * 170m) + 8;
                        <div class="bar-item" title="@dia.Dia: S/ @dia.Total.ToString("N2")">
                            <div class="bar animated" style="height:@(alturaPx)px; --target-height:@(alturaPx)px;"></div>
                            <div class="bar-label">@dia.Dia</div>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="stock-box">
            <h3>Productos con stock bajo</h3>
            <div class="stock-list">
                @if (!Model.ProductosStockBajo.Any())
                {
                    <div class="stock-item"><i class="fas fa-check-circle" style="color:#28A745;"></i><span class="name">Sin alertas de stock</span><span class="qty">OK</span></div>
                }
                else
                {
                    @foreach (var prod in Model.ProductosStockBajo)
                    {
                        <div class="stock-item">
                            <i class="fas fa-bell"></i>
                            <span class="name">@prod.nombre</span>
                            <span class="qty">@prod.stockActual @(prod.unidadMedida?.abreviatura ?? "UNI")</span>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- ACCESOS RÁPIDOS -->
    <div class="quick-access-section">
        <h3>Accesos rápidos</h3>
        <div class="quick-access">
            <a asp-controller="Venta" asp-action="Index" class="quick-btn qb-ventas" data-view="ventas"><i class="fas fa-shopping-cart"></i><span class="label">Ventas</span></a>
            <a asp-controller="Cotizaciones" asp-action="Index" class="quick-btn qb-ventas" data-view="cotizaciones"><i class="fas fa-file-signature"></i><span class="label">Cotizaciones</span></a>
            <a asp-controller="Producto" asp-action="Index" class="quick-btn qb-inventario" data-view="inventory"><i class="fas fa-cube"></i><span class="label">Inventario</span></a>
            <a asp-controller="Caja" asp-action="Index" class="quick-btn qb-caja" data-view="caja"><i class="fas fa-cash-register"></i><span class="label">Caja</span></a>
            <a asp-controller="Cliente" asp-action="Index" class="quick-btn qb-clientes" data-view="clientes"><i class="fas fa-users"></i><span class="label">Clientes</span></a>
            <a asp-controller="Proveedor" asp-action="Index" class="quick-btn qb-proveedores" data-view="proveedores"><i class="fas fa-truck"></i><span class="label">Proveedores</span></a>
            <a asp-controller="RequerimientoCompra" asp-action="Index" class="quick-btn qb-proveedores" data-view="requerimientos"><i class="fas fa-clipboard-list"></i><span class="label">Requerimientos</span></a>
            <a asp-controller="OrdenCompra" asp-action="Index" class="quick-btn qb-ventas" data-view="ordenes-compra"><i class="fas fa-file-invoice-dollar"></i><span class="label">Órdenes Compra</span></a>
            <a asp-controller="IngresoMercaderia" asp-action="Index" class="quick-btn qb-inventario" data-view="ingresos"><i class="fas fa-dolly"></i><span class="label">Ingresos</span></a>
            <a asp-controller="Reporte" asp-action="Index" class="quick-btn qb-reportes" data-view="reportes"><i class="fas fa-file-alt"></i><span class="label">Reportes</span></a>
            <a asp-controller="Usuario" asp-action="Index" class="quick-btn qb-usuarios" data-view="usuarios"><i class="fas fa-user-cog"></i><span class="label">Usuarios</span></a>
            <a href="#" class="quick-btn qb-configuracion" data-view="configuracion"><i class="fas fa-cog"></i><span class="label">Configuración</span></a>
        </div>
    </div>

    <!-- FILA INFERIOR: VENTAS POR CATEGORÍA Y TOP PRODUCTOS -->
    <div class="row-bottom">
        <div class="pie-box">
            <h3>Ventas por categoría (Este mes)</h3>
            <div class="pie-container">
                <div class="donut-wrapper">
                    <div class="donut-chart" style="@donutStyle"></div>
                    <div class="donut-hole"></div>
                </div>
                <div class="pie-legend">
                    @if (!Model.VentasPorCategoriaMes.Any())
                    {
                        <div class="legend-item"><span class="color-box" style="background:#ced4da;"></span> Sin ventas este mes <span class="value">S/ 0.00</span></div>
                    }
                    else
                    {
                        @for (int i = 0; i < Model.VentasPorCategoriaMes.Count; i++)
                        {
                            var cat = Model.VentasPorCategoriaMes[i];
                            var color = coloresCat[i % coloresCat.Length];
                            <div class="legend-item"><span class="color-box" style="background:@color;"></span> @cat.Categoria <span class="value">S/ @cat.Total.ToString("N2")</span></div>
                        }
                    }
                </div>
            </div>
        </div>
        <div class="top-box">
            <h3>Top productos más vendidos</h3>
            <div class="top-list">
                @if (!Model.TopProductos.Any())
                {
                    <div class="top-item"><span class="rank">-</span><span class="name">Sin ventas registradas</span></div>
                }
                else
                {
                    @for (int i = 0; i < Model.TopProductos.Count; i++)
                    {
                        <div class="top-item"><span class="rank">@(i + 1)</span><span class="name">@Model.TopProductos[i]</span></div>
                    }
                }
            </div>
        </div>
    </div>
</div>
