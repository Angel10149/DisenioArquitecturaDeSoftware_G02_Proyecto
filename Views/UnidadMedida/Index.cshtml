@model IEnumerable<AppWeb.Models.UnidadMedida>
@{
    ViewData["Title"] = "Unidades de Medida";
    Layout = "_LayoutDashboard";
}

<div id="viewUnidadesMedida" class="view-container active">
    <div class="view-header" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
        <div>
            <h2>Unidades de Medida</h2>
            <div class="breadcrumb">Inicio &gt; <span>Unidades de Medida</span></div>
        </div>
        <a asp-controller="UnidadMedida" asp-action="Crear"
           style="background:#304D8A; color:#fff; padding:10px 18px; border-radius:8px; text-decoration:none; font-weight:500; display:inline-flex; align-items:center; gap:8px;">
            <i class="fas fa-plus"></i> Nueva Unidad
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div style="margin-bottom: 15px; padding: 10px 15px; border-radius: 6px; background: #d4edda; color: #155724;">
            @TempData["Mensaje"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div style="margin-bottom: 15px; padding: 10px 15px; border-radius: 6px; background: #f8d7da; color: #721c24;">
            @TempData["Error"]
        </div>
    }

    <!-- TARJETAS DE MÉTRICAS -->
    <div class="metrics-row">
        <div class="metric-box">
            <span class="label">Total Unidades</span>
            <span class="value">@Model.Count()</span>
        </div>
        <div class="metric-box">
            <span class="label">Unidades Activas</span>
            <span class="value">@Model.Count(u => u.estado)</span>
        </div>
        <div class="metric-box">
            <span class="label">En Uso (Productos)</span>
            <span class="value">@Model.Count(u => u.Productos.Any())</span>
        </div>
    </div>

    <!-- BUSCADOR -->
    <form asp-controller="UnidadMedida" asp-action="Index" method="get" style="display:flex; gap:10px; margin-bottom:16px; flex-wrap:wrap;">
        <input type="text" name="buscar" value="@ViewBag.Buscar" placeholder="Buscar por nombre o abreviatura..."
               style="flex:1; min-width:240px; padding:9px 12px; border:1px solid #ced4da; border-radius:6px;" />
        <button type="submit" style="padding:9px 16px; border:none; border-radius:6px; background:#304D8A; color:#fff; cursor:pointer;">
            <i class="fas fa-search"></i> Buscar
        </button>
        @if (!string.IsNullOrWhiteSpace(ViewBag.Buscar as string))
        {
            <a asp-controller="UnidadMedida" asp-action="Index"
               style="padding:9px 16px; border-radius:6px; background:#e2e6ea; color:#333; text-decoration:none; display:inline-flex; align-items:center;">
                Limpiar
            </a>
        }
    </form>

    <!-- TABLA DE UNIDADES DE MEDIDA -->
    <div class="table-wrapper">
        <table class="data-table" id="unidadesTable">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Abreviatura</th>
                    <th>Productos</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" style="text-align:center; padding:20px; color:#6c757d;">
                            No se encontraron unidades de medida registradas.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var unidad in Model)
                    {
                        <tr>
                            <td>@unidad.idUnidadMedida</td>
                            <td><strong>@unidad.nombre</strong></td>
                            <td><span style="background:#eef2f7; color:#304D8A; padding:3px 8px; border-radius:4px; font-weight:600;">@unidad.abreviatura</span></td>
                            <td>@(unidad.Productos?.Count ?? 0)</td>
                            <td>
                                @if (unidad.estado)
                                {
                                    <span style="color:#28A745; font-weight:600;">Activo</span>
                                }
                                else
                                {
                                    <span style="color:#FFC107; font-weight:600;">Inactivo</span>
                                }
                            </td>
                            <td style="white-space:nowrap;">
                                <a asp-controller="UnidadMedida" asp-action="Editar" asp-route-id="@unidad.idUnidadMedida"
                                   style="padding:4px 10px; border-radius:4px; text-decoration:none; font-size:0.85rem; color:#fff; background:#304D8A; margin-right:4px; display:inline-block;">
                                    Editar
                                </a>
                                <form asp-controller="UnidadMedida" asp-action="CambiarEstado" asp-route-id="@unidad.idUnidadMedida" method="post" style="display:inline;">
                                    <button type="submit"
                                            style="padding:4px 10px; border:none; border-radius:4px; cursor:pointer; font-size:0.85rem; color:#fff; background:@(unidad.estado ? "#DC3545" : "#28A745");"
                                            onclick="return confirm('@(unidad.estado ? "¿Desactivar esta unidad de medida?" : "¿Activar esta unidad de medida?")');">
                                        @(unidad.estado ? "Desactivar" : "Activar")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

