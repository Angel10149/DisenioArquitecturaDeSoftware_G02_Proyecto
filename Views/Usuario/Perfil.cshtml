@model AppWeb.Models.Usuario
@{
    ViewData["Title"] = "Mi Perfil";
    Layout = "_LayoutDashboard";
}

<div id="viewPerfilUsuario" class="view-container active">
    <div class="view-header" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
        <div>
            <h2>Mi Perfil</h2>
            <div class="breadcrumb">
                <a asp-controller="Home" asp-action="Index" style="color:inherit; text-decoration:none;">Inicio</a> &gt;
                <span>Mi Perfil</span>
            </div>
        </div>
        <a asp-controller="Home" asp-action="Index"
           style="background:#6c757d; color:#fff; padding:8px 16px; border-radius:8px; text-decoration:none; font-weight:500; display:inline-flex; align-items:center; gap:8px;">
            <i class="fas fa-arrow-left"></i> Volver
        </a>
    </div>

    <div class="table-wrapper" style="padding: 24px; max-width: 700px;">
        @if (TempData["Mensaje"] != null)
        {
            <div style="margin-bottom: 15px; padding: 10px 15px; border-radius: 6px; background: #d4edda; color: #155724;">
                @TempData["Mensaje"]
            </div>
        }
        @if (ViewData["Error"] != null)
        {
            <div style="margin-bottom: 15px; padding: 10px 15px; border-radius: 6px; background: #f8d7da; color: #721c24;">
                @ViewData["Error"]
            </div>
        }

        <div style="padding:14px 16px; border-radius:6px; background:#f8f9fa; border:1px solid #dee2e6; margin-bottom:20px; display:flex; justify-content:space-between; flex-wrap:wrap; gap:12px;">
            <div><strong>Correo:</strong> @Model.correo</div>
            <div><strong>Teléfono:</strong> @Model.telefono</div>
            <div><strong>Rol:</strong> @(Model.Rol?.nameRol ?? "-")</div>
        </div>

        <form asp-controller="Usuario" asp-action="Perfil" method="post" autocomplete="off">
            <div style="margin-bottom:20px;">
                <label style="display:block; font-weight:500; margin-bottom:6px;">Nombre de Usuario</label>
                <input type="text" name="nombreUsuario" value="@Model.nombreUsuario" maxlength="50" required
                       style="width:100%; padding:10px 12px; border:1px solid #ced4da; border-radius:6px; box-sizing:border-box;" />
            </div>

            <hr style="border:none; border-top:1px solid #dee2e6; margin:20px 0;" />
            <h3 style="margin:0 0 12px 0; font-size:1.05rem;">Cambiar Contraseña (opcional)</h3>
            <p style="margin:0 0 14px 0; font-size:0.88rem; color:#6c757d;">
                Si no deseas cambiar tu contraseña, deja estos campos en blanco.
            </p>

            <div style="margin-bottom:14px;">
                <label style="display:block; font-weight:500; margin-bottom:6px;">Contraseña Actual</label>
                <input type="password" name="passwordActual" maxlength="100"
                       style="width:100%; padding:10px 12px; border:1px solid #ced4da; border-radius:6px; box-sizing:border-box;" />
            </div>

            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:16px; margin-bottom:20px;">
                <div>
                    <label style="display:block; font-weight:500; margin-bottom:6px;">Nueva Contraseña</label>
                    <input type="password" name="nuevaPassword" maxlength="100"
                           style="width:100%; padding:10px 12px; border:1px solid #ced4da; border-radius:6px; box-sizing:border-box;" />
                </div>
                <div>
                    <label style="display:block; font-weight:500; margin-bottom:6px;">Confirmar Nueva Contraseña</label>
                    <input type="password" name="confirmarPassword" maxlength="100"
                           style="width:100%; padding:10px 12px; border:1px solid #ced4da; border-radius:6px; box-sizing:border-box;" />
                </div>
            </div>

            <div style="display:flex; gap:10px; justify-content:flex-end;">
                <a asp-controller="Home" asp-action="Index"
                   style="padding:10px 18px; border-radius:6px; text-decoration:none; background:#e2e6ea; color:#333; font-weight:500;">
                    Cancelar
                </a>
                <button type="submit"
                        style="padding:10px 20px; border:none; border-radius:6px; background:#304D8A; color:#fff; font-weight:500; cursor:pointer;">
                    <i class="fas fa-save"></i> Guardar Perfil
                </button>
            </div>
        </form>
    </div>
</div>
