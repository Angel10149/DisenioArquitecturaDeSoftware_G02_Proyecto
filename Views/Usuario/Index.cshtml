@model IEnumerable<AppWeb.Models.Usuario>
@using System.Security.Claims
@{
    ViewData["Title"] = "Usuarios";
    Layout = "_LayoutDashboard";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div id="viewUsuarios" class="view-container active">
    <div class="view-header" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
        <div>
            <h2>Usuarios</h2>
            <div class="breadcrumb">Inicio &gt; <span>Usuarios</span></div>
        </div>
        <a asp-controller="Usuario" asp-action="Registro"
           style="background:#304D8A; color:#fff; padding:10px 18px; border-radius:8px; text-decoration:none; font-weight:500; display:inline-flex; align-items:center; gap:8px;">
            <i class="fas fa-user-plus"></i> Nuevo Usuario
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success" style="margin-bottom: 15px; padding: 10px 15px; border-radius: 6px; background: #d4edda; color: #155724;">
            @TempData["Mensaje"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" style="margin-bottom: 15px; padding: 10px 15px; border-radius: 6px; background: #f8d7da; color: #721c24;">
            @TempData["Error"]
        </div>
    }

    <!-- TARJETAS DE MÉTRICAS (calculadas con los datos reales) -->
    <div class="metrics-row">
        <div class="metric-box">
            <span class="label">Total Usuarios</span>
            <span class="value">@Model.Count()</span>
        </div>
        <div class="metric-box">
            <span class="label">Activos</span>
            <span class="value">@Model.Count(u => u.estado)</span>
        </div>
        <div class="metric-box">
            <span class="label">Administradores</span>
            <span class="value">@Model.Count(u => u.Rol?.nameRol == "Administrador")</span>
        </div>
        <div class="metric-box">
            <span class="label">Vendedores</span>
            <span class="value">@Model.Count(u => u.Rol?.nameRol == "Vendedor")</span>
        </div>
        <div class="metric-box">
            <span class="label">Cajeros</span>
            <span class="value">@Model.Count(u => u.Rol?.nameRol == "Cajero")</span>
        </div>
    </div>

    <!-- TABLA DE USUARIOS (iterando sobre la base de datos) -->
    <div class="table-wrapper">
        <table class="data-table" id="usuariosTable">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th>Rol</th>
                    <th>Teléfono</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody id="usuariosTableBody">
                @foreach (var usuario in Model)
                {
                    <tr>
                        <td>@usuario.id</td>
                        <td>@usuario.nombreUsuario</td>
                        <td>@usuario.correo</td>
                        <td>@(usuario.Rol?.nameRol ?? "Sin Rol")</td>
                        <td>@usuario.telefono</td>
                        <td>
                            @if (usuario.estado)
                            {
                                <span style="color:#28A745; font-weight:600;">Activo</span>
                            }
                            else
                            {
                                <span style="color:#FFC107; font-weight:600;">Inactivo</span>
                            }
                        </td>
                        <td style="white-space:nowrap;">
                            <a asp-controller="Usuario" asp-action="Editar" asp-route-id="@usuario.id"
                               style="padding:4px 10px; border-radius:4px; text-decoration:none; font-size:0.85rem; color:#fff; background:#304D8A; margin-right:4px; display:inline-block;">
                                Editar
                            </a>
                            @if (usuario.id.ToString() == currentUserId)
                            {
                                <span style="color:#6c757d; font-size:0.85rem;">Sesión actual</span>
                            }
                            else
                            {
                                <form asp-controller="Usuario" asp-action="CambiarEstado" asp-route-id="@usuario.id" method="post" style="display:inline;">
                                    <button type="submit"
                                            style="padding:4px 10px; border:none; border-radius:4px; cursor:pointer; font-size:0.85rem; color:#fff; background:@(usuario.estado ? "#DC3545" : "#28A745");"
                                            onclick="return confirm('@(usuario.estado ? "¿Desactivar este usuario?" : "¿Activar este usuario?")');">
                                        @(usuario.estado ? "Desactivar" : "Activar")
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>