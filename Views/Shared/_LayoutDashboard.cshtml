@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    bool isVentasCaja = currentController == "Venta" || currentController == "Cotizaciones" || currentController == "Cliente" || currentController == "Caja";
    bool isLogistica = currentController == "Producto" || currentController == "Inventario" || currentController == "Categoria" || currentController == "UnidadMedida" || currentController == "Proveedor" || currentController == "RequerimientoCompra" || currentController == "OrdenCompra" || currentController == "IngresoMercaderia";
    bool isAdmin = currentController == "Reporte" || currentController == "Usuario" || currentController == "Configuracion";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GRUPO MKG · @(ViewData["Title"] ?? "Dashboard")</title>

    <!-- Iconos FontAwesome y Google Fonts -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=OpenDyslexic&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Roboto:wght@400;500&display=swap" rel="stylesheet" />

    <!-- Estilos del sistema -->
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
</head>
<body id="page-dashboard">

    <!-- Formulario oculto para Logout seguro con token CSRF -->
    <form id="logoutForm" asp-controller="Usuario" asp-action="Logout" method="post" style="display:none;"></form>

    <div id="dashboardSection" style="display: block;">
        <div class="dashboard-container">
            <!-- SIDEBAR -->
            <aside class="sidebar" id="sidebar">
                <img src="https://i.postimg.cc/FRcSYwJ6/Logo-MKG.webp" alt="Logo" class="logo-side" />
                <nav>
                    <a class="@(currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                        <i class="fas fa-home"></i><span>Inicio</span>
                    </a>

                    <div class="nav-group @(isVentasCaja ? "open" : "")">
                        <button type="button" class="nav-group-toggle" aria-expanded="@(isVentasCaja ? "true" : "false")">
                            <span class="nav-group-label"><i class="fas fa-store"></i><span>Ventas y Caja</span></span>
                            <i class="fas fa-chevron-down nav-chevron"></i>
                        </button>
                        <div class="nav-group-items">
                            <a class="@(currentController == "Venta" ? "active" : "")" asp-controller="Venta" asp-action="Index">
                                <i class="fas fa-shopping-cart"></i><span>Ventas</span>
                            </a>
                            <a class="@(currentController == "Cotizaciones" ? "active" : "")" asp-controller="Cotizaciones" asp-action="Index">
                                <i class="fas fa-file-signature"></i><span>Cotizaciones</span>
                            </a>
                            <a class="@(currentController == "Cliente" ? "active" : "")" asp-controller="Cliente" asp-action="Index">
                                <i class="fas fa-users"></i><span>Clientes</span>
                            </a>
                            <a class="@(currentController == "Caja" ? "active" : "")" asp-controller="Caja" asp-action="Index">
                                <i class="fas fa-cash-register"></i><span>Caja</span>
                            </a>
                        </div>
                    </div>

                    <div class="nav-group @(isLogistica ? "open" : "")">
                        <button type="button" class="nav-group-toggle" aria-expanded="@(isLogistica ? "true" : "false")">
                            <span class="nav-group-label"><i class="fas fa-warehouse"></i><span>Inventario y Compras</span></span>
                            <i class="fas fa-chevron-down nav-chevron"></i>
                        </button>
                        <div class="nav-group-items">
                            <a class="@(currentController == "Producto" || currentController == "Inventario" ? "active" : "")" asp-controller="Producto" asp-action="Index">
                                <i class="fas fa-boxes"></i><span>Inventario</span>
                            </a>
                            <a class="@(currentController == "Proveedor" ? "active" : "")" asp-controller="Proveedor" asp-action="Index">
                                <i class="fas fa-truck"></i><span>Proveedores</span>
                            </a>
                            <a class="@(currentController == "RequerimientoCompra" ? "active" : "")" asp-controller="RequerimientoCompra" asp-action="Index">
                                <i class="fas fa-clipboard-list"></i><span>Requerimientos</span>
                            </a>
                            <a class="@(currentController == "OrdenCompra" ? "active" : "")" asp-controller="OrdenCompra" asp-action="Index">
                                <i class="fas fa-file-invoice-dollar"></i><span>Órdenes Compra</span>
                            </a>
                            <a class="@(currentController == "IngresoMercaderia" ? "active" : "")" asp-controller="IngresoMercaderia" asp-action="Index">
                                <i class="fas fa-dolly"></i><span>Ingresos</span>
                            </a>
                        </div>
                    </div>

                    <div class="nav-group @(isAdmin ? "open" : "")">
                        <button type="button" class="nav-group-toggle" aria-expanded="@(isAdmin ? "true" : "false")">
                            <span class="nav-group-label"><i class="fas fa-shield-alt"></i><span>Administración</span></span>
                            <i class="fas fa-chevron-down nav-chevron"></i>
                        </button>
                        <div class="nav-group-items">
                            <a class="@(currentController == "Reporte" ? "active" : "")" asp-controller="Reporte" asp-action="Index">
                                <i class="fas fa-file-alt"></i><span>Reportes</span>
                            </a>
                            <a class="@(currentController == "Usuario" ? "active" : "")" asp-controller="Usuario" asp-action="Index">
                                <i class="fas fa-user-cog"></i><span>Usuarios</span>
                            </a>
                            <a class="@(currentController == "Configuracion" ? "active" : "")" href="#">
                                <i class="fas fa-cog"></i><span>Configuración</span>
                            </a>
                        </div>
                    </div>

                    <div class="logout-btn">
                        <a id="btnCerrarSesion" href="javascript:void(0);" onclick="document.getElementById('logoutForm').submit();">
                            <i class="fas fa-sign-out-alt"></i><span>Cerrar sesión</span>
                        </a>
                    </div>
                </nav>
            </aside>

            <!-- MAIN CONTENT -->
            <main class="main-content">
                <!-- TOP BAR -->
                <div class="top-bar">
                    <div class="menu-icon" id="menuToggle">
                        <span></span><span></span><span></span><span></span>
                    </div>

                    <div class="search-wrapper-global">
                        <i class="fas fa-search"></i>
                        <input type="text" id="globalSearch" placeholder="Buscar productos, clientes, ventas..." autocomplete="off" />
                        <div class="search-results" id="searchResults"></div>
                    </div>

                    <div class="top-right">
                        <!-- Notificaciones -->
                        <div class="notification-wrapper">
                            <button class="notification-bell" id="notifBtn" aria-label="Notificaciones">
                                <i class="fas fa-bell"></i>
                                <span class="badge" id="notifBadge" style="display:none;">0</span>
                            </button>
                            <div class="notif-dropdown" id="notifDropdown">
                                <div class="notif-header">📬 Notificaciones</div>
                                <div id="notifItemsContainer">
                                    <div class="notif-item">
                                        <i class="fas fa-spinner fa-spin" style="color:#304D8A;"></i>
                                        <div class="notif-text">Cargando notificaciones...</div>
                                    </div>
                                </div>
                                <div class="notif-footer">
                                    <a asp-controller="Reporte" asp-action="Index">Ver alertas y reportes</a>
                                </div>
                            </div>
                        </div>

                        <!-- Perfil Usuario -->
                        <div class="profile-wrapper">
                            <button class="admin-profile" id="profileBtn">
                                <i class="fas fa-user"></i>
                                @(User.Identity?.Name ?? User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Administrador")
                                <i class="fas fa-chevron-down"></i>
                            </button>
                            <div class="profile-dropdown" id="profileDropdown">
                                <button type="button" class="profile-item" id="perfilBtn" onclick="window.location.href='@Url.Action("Perfil", "Usuario")';">
                                    <i class="fas fa-user-circle"></i> Mi Perfil
                                </button>
                                <button type="button" class="profile-item" id="configBtn">
                                    <i class="fas fa-cog"></i> Configuración
                                </button>
                                <div class="profile-divider"></div>
                                <button type="button" class="profile-item danger" id="logoutBtn" onclick="document.getElementById('logoutForm').submit();">
                                    <i class="fas fa-sign-out-alt"></i> Cerrar sesión
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- CONTENIDO PRINCIPAL DE CADA VISTA -->
                @RenderBody()

            </main>
        </div>
    </div>

    <!-- PANEL DE ACCESIBILIDAD REUTILIZABLE -->
    <partial name="_PanelAccesibilidad" />

    <!-- SCRIPTS DE INTERACCIÓN DE INTERFAZ -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Grupos desplegables en el menú lateral
            document.querySelectorAll(".nav-group-toggle").forEach(function (btn) {
                btn.addEventListener("click", function () {
                    const group = btn.closest(".nav-group");
                    if (!group) return;
                    const isOpen = group.classList.toggle("open");
                    btn.setAttribute("aria-expanded", isOpen ? "true" : "false");
                });
            });

            // Dropdown de perfil
            const profileBtn = document.getElementById("profileBtn");
            const profileDropdown = document.getElementById("profileDropdown");
            if (profileBtn && profileDropdown) {
                profileBtn.addEventListener("click", function (e) {
                    e.stopPropagation();
                    profileDropdown.classList.toggle("active");
                    if (notifDropdown) notifDropdown.classList.remove("active");
                });
            }

            // Dropdown de notificaciones
            const notifBtn = document.getElementById("notifBtn");
            const notifDropdown = document.getElementById("notifDropdown");
            if (notifBtn && notifDropdown) {
                notifBtn.addEventListener("click", function (e) {
                    e.stopPropagation();
                    notifDropdown.classList.toggle("active");
                    if (profileDropdown) profileDropdown.classList.remove("active");
                });
            }

            // Toggle de Sidebar
            const menuToggle = document.getElementById("menuToggle");
            const sidebar = document.getElementById("sidebar");
            if (menuToggle && sidebar) {
                menuToggle.addEventListener("click", function () {
                    sidebar.classList.toggle("active");
                    menuToggle.classList.toggle("active");
                });
            }

            // Panel de Accesibilidad
            const accessibilityToggle = document.getElementById("accessibilityToggle");
            const accessibilityPanel = document.getElementById("accessibilityPanel");
            const closePanel = document.getElementById("closePanel");

            if (accessibilityToggle && accessibilityPanel) {
                accessibilityToggle.addEventListener("click", function (e) {
                    e.stopPropagation();
                    accessibilityPanel.classList.toggle("active");
                    accessibilityToggle.classList.toggle("active");
                });
            }

            if (closePanel && accessibilityPanel) {
                closePanel.addEventListener("click", function () {
                    accessibilityPanel.classList.remove("active");
                    if (accessibilityToggle) accessibilityToggle.classList.remove("active");
                });
            }

            // Cerrar dropdowns si se hace clic afuera
            document.addEventListener("click", function (e) {
                if (profileDropdown && !profileDropdown.contains(e.target) && e.target !== profileBtn) {
                    profileDropdown.classList.remove("active");
                }
                if (notifDropdown && !notifDropdown.contains(e.target) && e.target !== notifBtn) {
                    notifDropdown.classList.remove("active");
                }
                if (accessibilityPanel && !accessibilityPanel.contains(e.target) && e.target !== accessibilityToggle && !accessibilityToggle.contains(e.target)) {
                    accessibilityPanel.classList.remove("active");
                    if (accessibilityToggle) accessibilityToggle.classList.remove("active");
                }
            });

            // ===== ACCESIBILIDAD COMPLETA (DEL PROTOTIPO) =====
            const ACCESSIBILITY_STORAGE_KEY = "grupo-mkg-accessibility-state";
            const counter = document.getElementById("accessibilityCounter");
            let accState = {
                textSize: "normal",
                lineSpacing: "normal",
                highContrast: false,
                daltonism: false,
                dyslexicFont: false,
                underlineLinks: false,
                textReader: false
            };

            function saveAccessibilityState() {
                try {
                    localStorage.setItem(ACCESSIBILITY_STORAGE_KEY, JSON.stringify(accState));
                } catch (e) { }
            }

            function loadAccessibilityState() {
                try {
                    const saved = localStorage.getItem(ACCESSIBILITY_STORAGE_KEY);
                    if (saved) {
                        accState = { ...accState, ...JSON.parse(saved) };
                    }
                } catch (e) { }
            }

            function updateCounter() {
                if (!counter) return;
                let count = 0;
                if (accState.textSize !== "normal") count++;
                if (accState.lineSpacing !== "normal") count++;
                if (accState.highContrast) count++;
                if (accState.daltonism) count++;
                if (accState.dyslexicFont) count++;
                if (accState.underlineLinks) count++;
                if (accState.textReader) count++;
                counter.textContent = count;
                counter.style.display = count > 0 ? "block" : "none";
            }

            let hoverTimeout = null;
            function speakText(text) {
                if (!window.speechSynthesis) return;
                window.speechSynthesis.cancel();
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = "es-ES";
                utterance.rate = 0.9;
                window.speechSynthesis.speak(utterance);
            }

            function handleTextReaderHover(e) {
                if (!accState.textReader) return;
                const textEl = e.target.closest(".view-container, .sidebar, .top-bar, .metric-card, .chart-box, .stock-box, .pie-box, .top-box, .data-table, .metric-box, .welcome-row, .view-header");
                if (textEl) {
                    const text = textEl.textContent.trim();
                    if (text.length > 0) {
                        if (hoverTimeout) clearTimeout(hoverTimeout);
                        hoverTimeout = setTimeout(() => speakText(text), 300);
                    }
                }
            }

            function syncAccessibilityControls() {
                const hc = document.getElementById("highContrast");
                const dl = document.getElementById("daltonism");
                const df = document.getElementById("dyslexicFont");
                const ul = document.getElementById("underlineLinks");
                const tr = document.getElementById("textReader");
                if (hc) hc.checked = accState.highContrast;
                if (dl) dl.checked = accState.daltonism;
                if (df) df.checked = accState.dyslexicFont;
                if (ul) ul.checked = accState.underlineLinks;
                if (tr) tr.checked = accState.textReader;

                document.querySelectorAll("[data-size]").forEach(b => b.classList.remove("active"));
                document.querySelector(`[data-size="${accState.textSize}"]`)?.classList.add("active");
                document.querySelectorAll("[data-line]").forEach(b => b.classList.remove("active"));
                document.querySelector(`[data-line="${accState.lineSpacing}"]`)?.classList.add("active");
            }

            function applyAccessibility() {
                const body = document.body;
                const html = document.documentElement;

                body.classList.remove("text-small", "text-normal", "text-large");
                body.classList.add(`text-${accState.textSize}`);

                body.classList.remove("line-spacing-compact", "line-spacing-normal", "line-spacing-wide");
                body.classList.add(`line-spacing-${accState.lineSpacing}`);

                body.classList.toggle("high-contrast", accState.highContrast);
                body.classList.toggle("daltonism", accState.daltonism);
                body.classList.toggle("font-dyslexic", accState.dyslexicFont);
                html.classList.toggle("font-dyslexic", accState.dyslexicFont);
                body.classList.toggle("underline-links", accState.underlineLinks);

                if (accState.textReader) {
                    document.addEventListener("mouseover", handleTextReaderHover);
                } else {
                    document.removeEventListener("mouseover", handleTextReaderHover);
                    if (window.speechSynthesis) window.speechSynthesis.cancel();
                }

                saveAccessibilityState();
                updateCounter();
            }

            document.querySelectorAll("[data-size]").forEach(btn => {
                btn.addEventListener("click", function () {
                    accState.textSize = this.dataset.size;
                    syncAccessibilityControls();
                    applyAccessibility();
                });
            });

            document.querySelectorAll("[data-line]").forEach(btn => {
                btn.addEventListener("click", function () {
                    accState.lineSpacing = this.dataset.line;
                    syncAccessibilityControls();
                    applyAccessibility();
                });
            });

            document.getElementById("highContrast")?.addEventListener("change", function () {
                accState.highContrast = this.checked;
                applyAccessibility();
            });
            document.getElementById("daltonism")?.addEventListener("change", function () {
                accState.daltonism = this.checked;
                applyAccessibility();
            });
            document.getElementById("dyslexicFont")?.addEventListener("change", function () {
                accState.dyslexicFont = this.checked;
                applyAccessibility();
            });
            document.getElementById("underlineLinks")?.addEventListener("change", function () {
                accState.underlineLinks = this.checked;
                applyAccessibility();
            });
            document.getElementById("textReader")?.addEventListener("change", function () {
                accState.textReader = this.checked;
                applyAccessibility();
            });

            document.getElementById("resetAccessibility")?.addEventListener("click", function () {
                accState = {
                    textSize: "normal",
                    lineSpacing: "normal",
                    highContrast: false,
                    daltonism: false,
                    dyslexicFont: false,
                    underlineLinks: false,
                    textReader: false
                };
                syncAccessibilityControls();
                applyAccessibility();
            });

            loadAccessibilityState();
            syncAccessibilityControls();
            applyAccessibility();

            // ===== NOTIFICACIONES REALES =====
            const notifContainer = document.getElementById("notifItemsContainer");
            const notifBadge = document.getElementById("notifBadge");
            if (notifContainer) {
                fetch('@Url.Action("Notificaciones", "Home")')
                    .then(r => r.ok ? r.json() : [])
                    .then(items => {
                        if (!items || items.length === 0) {
                            notifContainer.innerHTML = '<div class="notif-item"><i class="fas fa-check-circle" style="color:#28A745;"></i><div class="notif-text">Sin notificaciones pendientes</div></div>';
                            if (notifBadge) notifBadge.style.display = "none";
                            return;
                        }
                        if (notifBadge) {
                            notifBadge.textContent = items.length;
                            notifBadge.style.display = "inline-block";
                        }
                        notifContainer.innerHTML = items.map(it =>
                            `<a href="${it.url}" class="notif-item" style="text-decoration:none; color:inherit;">
                                <i class="fas ${it.icono}" style="color:${it.color};"></i>
                                <div class="notif-text">${it.texto}</div>
                                <span class="notif-time">${it.tiempo}</span>
                            </a>`
                        ).join("");
                    })
                    .catch(() => { });
            }

            // ===== BUSCADOR GLOBAL =====
            const globalSearch = document.getElementById("globalSearch");
            const searchResults = document.getElementById("searchResults");
            let searchTimer = null;
            if (globalSearch && searchResults) {
                globalSearch.addEventListener("input", function () {
                    const q = this.value.trim();
                    if (searchTimer) clearTimeout(searchTimer);
                    if (q.length < 2) {
                        searchResults.innerHTML = "";
                        searchResults.classList.remove("active");
                        return;
                    }
                    searchTimer = setTimeout(() => {
                        fetch('@Url.Action("BuscarGlobal", "Home")?q=' + encodeURIComponent(q))
                            .then(r => r.ok ? r.json() : [])
                            .then(items => {
                                if (!items || items.length === 0) {
                                    searchResults.innerHTML = '<div class="search-result-item" style="padding:10px 14px; color:#6c757d;">Sin resultados</div>';
                                } else {
                                    searchResults.innerHTML = items.map(it =>
                                        `<a href="${it.url}" class="search-result-item" style="display:flex; align-items:center; gap:10px; padding:10px 14px; text-decoration:none; color:inherit; border-bottom:1px solid #f1f3f5;">
                                            <i class="fas ${it.icono}" style="color:#304D8A;"></i>
                                            <div>
                                                <div style="font-weight:600; font-size:0.9rem;">${it.titulo} <span style="font-size:0.75rem; color:#6c757d;">(${it.tipo})</span></div>
                                                <div style="font-size:0.8rem; color:#6c757d;">${it.subtitulo}</div>
                                            </div>
                                        </a>`
                                    ).join("");
                                }
                                searchResults.classList.add("active");
                            })
                            .catch(() => { });
                    }, 250);
                });

                document.addEventListener("click", function (e) {
                    if (!globalSearch.contains(e.target) && !searchResults.contains(e.target)) {
                        searchResults.classList.remove("active");
                    }
                });
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

