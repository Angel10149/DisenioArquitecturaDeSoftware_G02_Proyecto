<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AppWeb</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AppWeb.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">AppWeb</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                            </li>
                        }
                        @*Administrador*@
                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="#">
                                    Usuarios
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="#">
                                    Administracion
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="#">
                                    Reportes
                                </a>
                            </li>
                        }
                        @*Socio*@
                        @if (User.IsInRole("Socio"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="#">
                                    Mis tareas
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="#">
                                    Proyectos
                                </a>
                            </li>
                        }
                        @*Vendedor*@
                        @if (User.IsInRole("Vendedor"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="#">
                                    Mis servicios
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="#">
                                    Mi información
                                </a>
                            </li>
                        }
                        @*Cajero*@
                        @if (User.IsInRole("Cajero"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="#">
                                    Mis servicios
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="#">
                                    Mi información
                                </a>
                            </li>
                        }
                        @*Encargado de Inventario*@
                        @if (User.IsInRole("Encargado de Inventario"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="#">
                                    Mis servicios
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="#">
                                    Mi información
                                </a>
                            </li>
                        }
                        @*Encargado de Compras*@
                        @if (User.IsInRole("Encargado de Compras"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="#">
                                    Mis servicios
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="#">
                                    Mi información
                                </a>
                            </li>
                        }

                    </ul>
                    @*Informacion del usuario*@
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="d-flex align-items-center">
                            <span class="me-3">
                                @User.Identity.Name
                            </span>
                            <span class="badge bg-primary me-3">
                                @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                            </span>
                            <form asp-controller="Usuario" asp-action="Logout" method="post">
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    Cerrar Sesión
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - AppWeb - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
