@model AppWeb.Models.Pago
@{
    var comp = Model.Comprobantes?.FirstOrDefault();
    var tituloComp = comp != null ? $"{comp.tipoComprobante} {comp.serie}-{comp.numero}" : $"Pago #{Model.idPago}";
    ViewData["Title"] = tituloComp;
    Layout = "_LayoutDashboard";
    var cli = Model.venta?.cliente;
    var nombreCliente = !string.IsNullOrWhiteSpace(cli?.razonSocial) ? cli.razonSocial : (cli?.nombres ?? "-");
    var totalVenta = Model.venta?.total ?? 0m;
    var vuelto = Math.Max(0m, Model.montoRecibido - totalVenta);
}

<div id="viewComprobante" class="view-container active">
    <div class="view-header" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
        <div>
            <h2>@tituloComp</h2>
            <div class="breadcrumb">
                <a asp-controller="Home" asp-action="Index" style="color:inherit; text-decoration:none;">Inicio</a> &gt;
                <a asp-controller="Caja" asp-action="Index" style="color:inherit; text-decoration:none;">Caja</a> &gt;
                <span>@tituloComp</span>
            </div>
        </div>
        <div style="display:flex; gap:8px;">
            <button type="button" onclick="window.print()"
                    style="background:#304D8A; color:#fff; border:none; padding:8px 16px; border-radius:8px; cursor:pointer; font-weight:500; display:inline-flex; align-items:center; gap:8px;">
                <i class="fas fa-print"></i> Imprimir
            </button>
            <a asp-controller="Caja" asp-action="Index"
               style="background:#6c757d; color:#fff; padding:8px 16px; border-radius:8px; text-decoration:none; font-weight:500; display:inline-flex; align-items:center; gap:8px;">
                <i class="fas fa-arrow-left"></i> Volver
            </a>
        </div>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div style="margin-bottom: 15px; padding: 10px 15px; border-radius: 6px; background: #d4edda; color: #155724;">
            @TempData["Mensaje"]
        </div>
    }

    <div class="table-wrapper" style="padding: 28px; max-width: 820px;">
        <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:16px; border-bottom:2px solid #dee2e6; padding-bottom:16px; margin-bottom:20px;">
            <div>
                <h3 style="margin:0 0 4px 0; color:#304D8A;">GRUPO MKG</h3>
                <div style="font-size:0.9rem; color:#6c757d;">Comprobante de Venta</div>
            </div>
            <div style="text-align:right;">
                <div style="font-size:1.15rem; font-weight:700; color:#304D8A;">@tituloComp</div>
                <div style="font-size:0.9rem; color:#6c757d;">Fecha: @Model.fechaPago.ToString("yyyy-MM-dd HH:mm")</div>
            </div>
        </div>

        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px; margin-bottom:20px; font-size:0.95rem;">
            <div><strong>Cliente:</strong> @nombreCliente</div>
            <div><strong>Documento:</strong> @(cli != null ? $"{cli.tipoDocumento} {cli.numeroDocumento}" : "-")</div>
            <div><strong>Venta:</strong> #@Model.idVenta</div>
            <div><strong>Método de Pago:</strong> @Model.metodoPago</div>
            <div><strong>Cajero:</strong> @(Model.usuario?.nombreUsuario ?? "-")</div>
            <div><strong>Estado:</strong> <span style="color:#28A745; font-weight:600;">@Model.estado</span></div>
        </div>

        <table class="data-table" style="margin-bottom:20px;">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Cantidad</th>
                    <th>Precio Unit.</th>
                    <th>Descuento</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var det in Model.venta?.DetalleVentas ?? Enumerable.Empty<AppWeb.Models.DetalleVenta>())
                {
                    <tr>
                        <td>@(det.producto?.nombre ?? "-")</td>
                        <td>@det.cantidad</td>
                        <td>S/ @det.precioUnitario.ToString("N2")</td>
                        <td>S/ @det.descuento.ToString("N2")</td>
                        <td><strong>S/ @det.subtotal.ToString("N2")</strong></td>
                    </tr>
                }
            </tbody>
        </table>

        <div style="display:flex; flex-direction:column; align-items:flex-end; gap:6px; font-size:1.05rem;">
            <div>Total Venta: <strong>S/ @totalVenta.ToString("N2")</strong></div>
            <div>Monto Recibido: <strong>S/ @Model.montoRecibido.ToString("N2")</strong></div>
            <div>Vuelto: <strong style="color:#28A745;">S/ @vuelto.ToString("N2")</strong></div>
        </div>
    </div>
</div>
