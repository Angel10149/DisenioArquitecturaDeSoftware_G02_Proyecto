@using System.Globalization
@{
    ViewData["Title"] = "Cobrar Venta";
    Layout = "_LayoutDashboard";
    var ventasPendientes = ViewBag.VentasPendientes as IEnumerable<AppWeb.Models.Venta> ?? Enumerable.Empty<AppWeb.Models.Venta>();
    var ventaSel = ViewBag.VentaSeleccionada as AppWeb.Models.Venta;
    int? idVentaSel = ViewBag.IdVentaSeleccionada as int?;
}

<div id="viewCobrarVenta" class="view-container active">
    <div class="view-header" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
        <div>
            <h2>Cobrar Venta</h2>
            <div class="breadcrumb">
                <a asp-controller="Home" asp-action="Index" style="color:inherit; text-decoration:none;">Inicio</a> &gt;
                <a asp-controller="Caja" asp-action="Index" style="color:inherit; text-decoration:none;">Caja</a> &gt;
                <span>Cobrar Venta</span>
            </div>
        </div>
        <a asp-controller="Caja" asp-action="Index"
           style="background:#6c757d; color:#fff; padding:8px 16px; border-radius:8px; text-decoration:none; font-weight:500; display:inline-flex; align-items:center; gap:8px;">
            <i class="fas fa-arrow-left"></i> Volver
        </a>
    </div>

    <div class="table-wrapper" style="padding: 24px;">
        @if (ViewData["Error"] != null)
        {
            <div style="margin-bottom: 15px; padding: 10px 15px; border-radius: 6px; background: #f8d7da; color: #721c24;">
                @ViewData["Error"]
            </div>
        }

        <div style="margin-bottom: 20px;">
            <label style="display:block; font-weight:500; margin-bottom:6px;">Venta Pendiente de Cobro</label>
            <select id="selectVentaPendiente"
                    onchange="if(this.value){ window.location.href='@Url.Action("Cobrar", "Caja")?idVenta=' + this.value; } else { window.location.href='@Url.Action("Cobrar", "Caja")'; }"
                    style="width:100%; padding:10px 12px; border:1px solid #ced4da; border-radius:6px; box-sizing:border-box; background:#fff;">
                <option value="">Seleccione una venta pendiente...</option>
                @foreach (var v in ventasPendientes)
                {
                    var cliNom = !string.IsNullOrWhiteSpace(v.cliente?.razonSocial) ? v.cliente.razonSocial : (v.cliente?.nombres ?? "-");
                    <option value="@v.idVenta" selected="@(idVentaSel == v.idVenta)">
                        Venta #@v.idVenta - @cliNom (Total: S/ @v.total.ToString("N2"))
                    </option>
                }
            </select>
        </div>

        @if (ventaSel == null)
        {
            <div style="padding: 16px; border-radius: 6px; background: #eef2f7; color: #304D8A;">
                @if (!ventasPendientes.Any())
                {
                    <span>No hay ventas pendientes de cobro en este momento.</span>
                }
                else
                {
                    <span>Seleccione una venta pendiente para procesar el cobro y emitir el comprobante.</span>
                }
            </div>
        }
        else
        {
            var nombreCliente = !string.IsNullOrWhiteSpace(ventaSel.cliente?.razonSocial)
                ? ventaSel.cliente.razonSocial
                : (ventaSel.cliente?.nombres ?? "-");

            <div style="padding:14px 16px; border-radius:6px; background:#f8f9fa; border:1px solid #dee2e6; margin-bottom:20px; display:flex; justify-content:space-between; flex-wrap:wrap; gap:12px;">
                <div><strong>Venta:</strong> #@ventaSel.idVenta</div>
                <div><strong>Cliente:</strong> @nombreCliente (@(ventaSel.cliente?.numeroDocumento ?? "-"))</div>
                <div><strong>Fecha:</strong> @ventaSel.fechaVenta.ToString("yyyy-MM-dd HH:mm")</div>
                <div><strong>Total a Pagar:</strong> <span style="color:#304D8A; font-weight:700;">S/ @ventaSel.total.ToString("N2")</span></div>
            </div>

            <table class="data-table" style="margin-bottom:20px;">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Cantidad</th>
                        <th>Precio Unit.</th>
                        <th>Descuento</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var det in ventaSel.DetalleVentas)
                    {
                        <tr>
                            <td>@(det.producto?.nombre ?? "-")</td>
                            <td>@det.cantidad</td>
                            <td>S/ @det.precioUnitario.ToString("N2")</td>
                            <td>S/ @det.descuento.ToString("N2")</td>
                            <td><strong>S/ @det.subtotal.ToString("N2")</strong></td>
                        </tr>
                    }
                </tbody>
            </table>

            <form asp-controller="Caja" asp-action="Cobrar" method="post" autocomplete="off">
                <input type="hidden" name="idVenta" value="@ventaSel.idVenta" />

                <div style="display:grid; grid-template-columns: 1fr 1fr 1fr; gap:16px; margin-bottom:16px;">
                    <div>
                        <label style="display:block; font-weight:500; margin-bottom:6px;">Método de Pago</label>
                        <select name="metodoPago" required
                                style="width:100%; padding:10px 12px; border:1px solid #ced4da; border-radius:6px; box-sizing:border-box; background:#fff;">
                            <option value="Efectivo">Efectivo</option>
                            <option value="Tarjeta">Tarjeta</option>
                            <option value="Transferencia">Transferencia</option>
                            <option value="Yape / Plin">Yape / Plin</option>
                        </select>
                    </div>
                    <div>
                        <label style="display:block; font-weight:500; margin-bottom:6px;">Tipo de Comprobante</label>
                        <select name="tipoComprobante" required
                                style="width:100%; padding:10px 12px; border:1px solid #ced4da; border-radius:6px; box-sizing:border-box; background:#fff;">
                            <option value="Boleta">Boleta (B001)</option>
                            <option value="Factura">Factura (F001)</option>
                            <option value="Ticket">Ticket (T001)</option>
                        </select>
                    </div>
                    <div>
                        <label style="display:block; font-weight:500; margin-bottom:6px;">Monto Recibido (S/)</label>
                        <input type="number" id="inputMontoRecibido" name="montoRecibido" step="0.01"
                               min="@ventaSel.total.ToString("0.00", CultureInfo.InvariantCulture)"
                               value="@ventaSel.total.ToString("0.00", CultureInfo.InvariantCulture)" required
                               style="width:100%; padding:10px 12px; border:1px solid #ced4da; border-radius:6px; box-sizing:border-box;" />
                    </div>
                </div>

                <div style="display:flex; justify-content:flex-end; align-items:center; gap:20px; margin-bottom:20px; font-size:1.1rem;">
                    <span>Total: <strong>S/ @ventaSel.total.ToString("N2")</strong></span>
                    <span>Vuelto: <strong id="textoVuelto" style="color:#28A745;">S/ 0.00</strong></span>
                </div>

                <div style="display:flex; gap:10px; justify-content:flex-end;">
                    <a asp-controller="Caja" asp-action="Index"
                       style="padding:10px 18px; border-radius:6px; text-decoration:none; background:#e2e6ea; color:#333; font-weight:500;">
                        Cancelar
                    </a>
                    <button type="submit"
                            style="padding:10px 20px; border:none; border-radius:6px; background:#28A745; color:#fff; font-weight:500; cursor:pointer;">
                        <i class="fas fa-check"></i> Confirmar Cobro y Emitir Comprobante
                    </button>
                </div>
            </form>
        }
    </div>
</div>

@if (ventaSel != null)
{
    @section Scripts {
        <script>
            (function () {
                const total = @ventaSel.total.ToString("0.00", CultureInfo.InvariantCulture);
                const input = document.getElementById('inputMontoRecibido');
                const vueltoTexto = document.getElementById('textoVuelto');
                if (!input || !vueltoTexto) return;

                function actualizarVuelto() {
                    const recibido = parseFloat(input.value) || 0;
                    const vuelto = Math.max(0, recibido - total);
                    vueltoTexto.textContent = 'S/ ' + vuelto.toFixed(2);
                }

                input.addEventListener('input', actualizarVuelto);
                actualizarVuelto();
            })();
        </script>
    }
}
