@model AppWeb.Models.Proveedor
@{
    ViewData["Title"] = "Nuevo Proveedor";
    Layout = "_LayoutDashboard";
}

<div id="viewCrearProveedor" class="view-container active">
    <div class="view-header" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
        <div>
            <h2>Nuevo Proveedor</h2>
            <div class="breadcrumb">
                <a asp-controller="Home" asp-action="Index" style="color:inherit; text-decoration:none;">Inicio</a> &gt;
                <a asp-controller="Proveedor" asp-action="Index" style="color:inherit; text-decoration:none;">Proveedores</a> &gt;
                <span>Nuevo Proveedor</span>
            </div>
        </div>
        <a asp-controller="Proveedor" asp-action="Index"
           style="background:#6c757d; color:#fff; padding:8px 16px; border-radius:8px; text-decoration:none; font-weight:500; display:inline-flex; align-items:center; gap:8px;">
            <i class="fas fa-arrow-left"></i> Volver
        </a>
    </div>

    <div class="table-wrapper" style="max-width: 700px; padding: 24px;">
        <form asp-controller="Proveedor" asp-action="Crear" method="post" autocomplete="off">
            <div asp-validation-summary="All" style="color:#DC3545; margin-bottom:15px;"></div>

            <div style="display:grid; grid-template-columns: 1fr 2fr; gap:14px; margin-bottom:14px;">
                <div>
                    <label asp-for="ruc" style="display:block; font-weight:500; margin-bottom:6px;">RUC</label>
                    <input type="text" asp-for="ruc" placeholder="Ej. 20123456789"
                           style="width:100%; padding:10px 12px; border:1px solid #ced4da; border-radius:6px; box-sizing:border-box;" />
                </div>
                <div>
                    <label asp-for="razonSocial" style="display:block; font-weight:500; margin-bottom:6px;">Razón Social</label>
                    <input type="text" asp-for="razonSocial" placeholder="Ej. AutoPartes Pérez S.A.C."
                           style="width:100%; padding:10px 12px; border:1px solid #ced4da; border-radius:6px; box-sizing:border-box;" />
                </div>
            </div>

            <div style="margin-bottom: 14px;">
                <label asp-for="contacto" style="display:block; font-weight:500; margin-bottom:6px;">Persona de Contacto</label>
                <input type="text" asp-for="contacto" placeholder="Ej. Carlos Pérez"
                       style="width:100%; padding:10px 12px; border:1px solid #ced4da; border-radius:6px; box-sizing:border-box;" />
            </div>

            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:14px; margin-bottom:14px;">
                <div>
                    <label asp-for="telefono" style="display:block; font-weight:500; margin-bottom:6px;">Teléfono</label>
                    <input type="text" asp-for="telefono" placeholder="Ej. 987654321"
                           style="width:100%; padding:10px 12px; border:1px solid #ced4da; border-radius:6px; box-sizing:border-box;" />
                </div>
                <div>
                    <label asp-for="email" style="display:block; font-weight:500; margin-bottom:6px;">Correo Electrónico</label>
                    <input type="email" asp-for="email" placeholder="contacto@proveedor.com"
                           style="width:100%; padding:10px 12px; border:1px solid #ced4da; border-radius:6px; box-sizing:border-box;" />
                </div>
            </div>

            <div style="margin-bottom: 20px;">
                <label asp-for="direccion" style="display:block; font-weight:500; margin-bottom:6px;">Dirección</label>
                <input type="text" asp-for="direccion" placeholder="Ej. Av. Principal 123"
                       style="width:100%; padding:10px 12px; border:1px solid #ced4da; border-radius:6px; box-sizing:border-box;" />
            </div>

            <div style="display:flex; gap:10px; justify-content:flex-end;">
                <a asp-controller="Proveedor" asp-action="Index"
                   style="padding:10px 18px; border-radius:6px; text-decoration:none; background:#e2e6ea; color:#333; font-weight:500;">
                    Cancelar
                </a>
                <button type="submit"
                        style="padding:10px 20px; border:none; border-radius:6px; background:#304D8A; color:#fff; font-weight:500; cursor:pointer;">
                    <i class="fas fa-save"></i> Guardar Proveedor
                </button>
            </div>
        </form>
    </div>
</div>

