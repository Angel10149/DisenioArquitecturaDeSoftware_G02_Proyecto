@model AppWeb.Controllers.ReporteResumenVM
@{
    ViewData["Title"] = "Reportes";
    Layout = "_LayoutDashboard";
    var balance = Model.TotalVentas - Model.TotalCompras;
}

<div id="viewReportes" class="view-container active">
    <div class="view-header" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
        <div>
            <h2>Reportes y Estadísticas</h2>
            <div class="breadcrumb">
                <a asp-controller="Home" asp-action="Index" style="color:inherit; text-decoration:none;">Inicio</a> &gt;
                <span>Reportes</span>
            </div>
        </div>
        <div style="display:flex; gap:8px; flex-wrap:wrap;">
            <a asp-controller="Reporte" asp-action="ExportarVentasCsv"
               asp-route-fechaInicio="@Model.FechaInicio.ToString("yyyy-MM-dd")"
               asp-route-fechaFin="@Model.FechaFin.ToString("yyyy-MM-dd")"
               style="background:#28A745; color:#fff; padding:9px 16px; border-radius:8px; text-decoration:none; font-weight:500; display:inline-flex; align-items:center; gap:8px;">
                <i class="fas fa-file-csv"></i> Exportar Ventas CSV
            </a>
            <button type="button" onclick="window.print()"
                    style="background:#304D8A; color:#fff; border:none; padding:9px 16px; border-radius:8px; cursor:pointer; font-weight:500; display:inline-flex; align-items:center; gap:8px;">
                <i class="fas fa-print"></i> Imprimir
            </button>
        </div>
    </div>

    <!-- FILTRO POR RANGO DE FECHAS -->
    <form asp-controller="Reporte" asp-action="Index" method="get" style="display:flex; gap:12px; margin-bottom:20px; flex-wrap:wrap; align-items:flex-end;">
        <div>
            <label style="display:block; font-size:0.85rem; font-weight:500; margin-bottom:4px;">Desde</label>
            <input type="date" name="fechaInicio" value="@Model.FechaInicio.ToString("yyyy-MM-dd")"
                   style="padding:8px 12px; border:1px solid #ced4da; border-radius:6px;" />
        </div>
        <div>
            <label style="display:block; font-size:0.85rem; font-weight:500; margin-bottom:4px;">Hasta</label>
            <input type="date" name="fechaFin" value="@Model.FechaFin.ToString("yyyy-MM-dd")"
                   style="padding:8px 12px; border:1px solid #ced4da; border-radius:6px;" />
        </div>
        <button type="submit" style="padding:9px 16px; border:none; border-radius:6px; background:#304D8A; color:#fff; cursor:pointer;">
            <i class="fas fa-filter"></i> Filtrar Periodo
        </button>
    </form>

    <!-- TARJETAS DE RESUMEN -->
    <div class="metrics-row">
        <div class="metric-box">
            <span class="label">Ventas (@Model.Ventas.Count)</span>
            <span class="value">S/ @Model.TotalVentas.ToString("N2")</span>
        </div>
        <div class="metric-box">
            <span class="label">Compras / Ingresos (@Model.Ingresos.Count)</span>
            <span class="value">S/ @Model.TotalCompras.ToString("N2")</span>
        </div>
        <div class="metric-box">
            <span class="label">Balance del Periodo</span>
            <span class="value" style="color:@(balance >= 0 ? "#28A745" : "#DC3545");">S/ @balance.ToString("N2")</span>
        </div>
        <div class="metric-box">
            <span class="label">Alertas Stock Bajo</span>
            <span class="value" style="color:@(Model.ProductosStockBajo.Any() ? "#DC3545" : "#28A745");">@Model.ProductosStockBajo.Count</span>
        </div>
    </div>

    <!-- TOP PRODUCTOS VENDIDOS Y STOCK BAJO -->
    <div style="display:grid; grid-template-columns: 1fr 1fr; gap:20px; margin-bottom:20px;">
        <div class="table-wrapper" style="padding:16px;">
            <h3 style="margin:0 0 12px 0; font-size:1.05rem;">Top Productos Más Vendidos</h3>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Cant.</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.TopProductos.Any())
                    {
                        <tr>
                            <td colspan="3" style="text-align:center; padding:16px; color:#6c757d;">Sin ventas en el periodo.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.TopProductos)
                        {
                            <tr>
                                <td><strong>@item.Nombre</strong> <span style="font-size:0.8rem; color:#6c757d;">(@item.Codigo)</span></td>
                                <td>@item.CantidadVendida</td>
                                <td><strong>S/ @item.TotalVendido.ToString("N2")</strong></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="table-wrapper" style="padding:16px;">
            <h3 style="margin:0 0 12px 0; font-size:1.05rem;">Productos con Stock Bajo</h3>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Actual</th>
                        <th>Mínimo</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.ProductosStockBajo.Any())
                    {
                        <tr>
                            <td colspan="3" style="text-align:center; padding:16px; color:#28A745;">Todo el stock está por encima del mínimo.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var prod in Model.ProductosStockBajo)
                        {
                            <tr>
                                <td><strong>@prod.nombre</strong> <span style="font-size:0.8rem; color:#6c757d;">(@(prod.categoria?.nombre ?? "-"))</span></td>
                                <td style="color:#DC3545; font-weight:700;">@prod.stockActual @(prod.unidadMedida?.abreviatura ?? "")</td>
                                <td>@prod.stockMinimo @(prod.unidadMedida?.abreviatura ?? "")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- DETALLE DE VENTAS DEL PERIODO -->
    <div class="table-wrapper" style="padding:16px;">
        <h3 style="margin:0 0 12px 0; font-size:1.05rem;">Ventas del Periodo</h3>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Venta</th>
                    <th>Fecha</th>
                    <th>Cliente</th>
                    <th>Vendedor</th>
                    <th>Estado</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Ventas.Any())
                {
                    <tr>
                        <td colspan="6" style="text-align:center; padding:16px; color:#6c757d;">No se registraron ventas en el rango seleccionado.</td>
                    </tr>
                }
                else
                {
                    @foreach (var v in Model.Ventas)
                    {
                        var cliNom = !string.IsNullOrWhiteSpace(v.cliente?.razonSocial) ? v.cliente.razonSocial : (v.cliente?.nombres ?? "-");
                        <tr>
                            <td><strong>#@v.idVenta</strong></td>
                            <td>@v.fechaVenta.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@cliNom</td>
                            <td>@(v.usuario?.nombreUsuario ?? "-")</td>
                            <td>@v.estado</td>
                            <td><strong>S/ @v.total.ToString("N2")</strong></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
