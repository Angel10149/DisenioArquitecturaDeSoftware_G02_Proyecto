@model IEnumerable<AppWeb.Models.Venta>
@{
    ViewData["Title"] = "Ventas";
    Layout = "_LayoutDashboard";
    string? estadoSel = ViewBag.Estado as string;
}

<div id="viewVentas" class="view-container active">
    <div class="view-header" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
        <div>
            <h2>Ventas</h2>
            <div class="breadcrumb">
                <a asp-controller="Home" asp-action="Index" style="color:inherit; text-decoration:none;">Inicio</a> &gt;
                <span>Ventas</span>
            </div>
        </div>
        <div style="display:flex; gap:8px; flex-wrap:wrap;">
            <a asp-controller="Cotizaciones" asp-action="Index"
               style="background:#e2e6ea; color:#333; padding:9px 14px; border-radius:8px; text-decoration:none; font-weight:500; display:inline-flex; align-items:center; gap:6px;">
                <i class="fas fa-file-signature"></i> Cotizaciones
            </a>
            <a asp-controller="Venta" asp-action="Crear"
               style="background:#304D8A; color:#fff; padding:9px 18px; border-radius:8px; text-decoration:none; font-weight:500; display:inline-flex; align-items:center; gap:8px;">
                <i class="fas fa-plus"></i> Nueva Venta
            </a>
        </div>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div style="margin-bottom: 15px; padding: 10px 15px; border-radius: 6px; background: #d4edda; color: #155724;">
            @TempData["Mensaje"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div style="margin-bottom: 15px; padding: 10px 15px; border-radius: 6px; background: #f8d7da; color: #721c24;">
            @TempData["Error"]
        </div>
    }

    <!-- TARJETAS DE MÉTRICAS -->
    <div class="metrics-row">
        <div class="metric-box">
            <span class="label">Total Ventas</span>
            <span class="value">@Model.Count()</span>
        </div>
        <div class="metric-box">
            <span class="label">Pendientes de Pago</span>
            <span class="value">@Model.Count(v => v.estado == "Pendiente")</span>
        </div>
        <div class="metric-box">
            <span class="label">Pagadas</span>
            <span class="value">@Model.Count(v => v.estado == "Pagada")</span>
        </div>
        <div class="metric-box">
            <span class="label">Monto Total</span>
            <span class="value">S/ @Model.Where(v => v.estado != "Anulada").Sum(v => v.total).ToString("N2")</span>
        </div>
    </div>

    <!-- FILTROS Y BUSCADOR -->
    <form asp-controller="Venta" asp-action="Index" method="get" style="display:flex; gap:10px; margin-bottom:16px; flex-wrap:wrap; align-items:center;">
        <select name="estado" onchange="this.form.submit()"
                style="padding:9px 12px; border:1px solid #ced4da; border-radius:6px; background:#fff;">
            <option value="">Todos los Estados</option>
            <option value="Pendiente" selected="@(estadoSel == "Pendiente")">Pendiente</option>
            <option value="Pagada" selected="@(estadoSel == "Pagada")">Pagada</option>
            <option value="Anulada" selected="@(estadoSel == "Anulada")">Anulada</option>
        </select>

        <input type="text" name="buscar" value="@ViewBag.Buscar" placeholder="Buscar por cliente, documento, vendedor o # venta..."
               style="flex:1; min-width:240px; padding:9px 12px; border:1px solid #ced4da; border-radius:6px;" />

        <button type="submit" style="padding:9px 16px; border:none; border-radius:6px; background:#304D8A; color:#fff; cursor:pointer;">
            <i class="fas fa-search"></i> Buscar
        </button>

        @if (!string.IsNullOrWhiteSpace(ViewBag.Buscar as string) || !string.IsNullOrWhiteSpace(estadoSel))
        {
            <a asp-controller="Venta" asp-action="Index"
               style="padding:9px 16px; border-radius:6px; background:#e2e6ea; color:#333; text-decoration:none; display:inline-flex; align-items:center;">
                Limpiar
            </a>
        }
    </form>

    <!-- TABLA DE VENTAS -->
    <div class="table-wrapper">
        <table class="data-table" id="ventasTable">
            <thead>
                <tr>
                    <th>Venta</th>
                    <th>Fecha</th>
                    <th>Cliente</th>
                    <th>Origen</th>
                    <th>Ítems</th>
                    <th>Total</th>
                    <th>Vendedor</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" style="text-align:center; padding:20px; color:#6c757d;">
                            No se encontraron ventas.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var v in Model)
                    {
                        var nombreCliente = !string.IsNullOrWhiteSpace(v.cliente?.razonSocial)
                            ? v.cliente.razonSocial
                            : (v.cliente?.nombres ?? "-");
                        var colorEstado = v.estado switch
                        {
                            "Pagada" => "#28A745",
                            "Anulada" => "#DC3545",
                            _ => "#FFC107"
                        };
                        <tr>
                            <td><strong>#@v.idVenta</strong></td>
                            <td>@v.fechaVenta.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@nombreCliente</td>
                            <td>@(v.idCotizacion.HasValue ? $"Cotización #{v.idCotizacion}" : "Directa")</td>
                            <td>@(v.DetalleVentas?.Count ?? 0)</td>
                            <td><strong>S/ @v.total.ToString("N2")</strong></td>
                            <td>@(v.usuario?.nombreUsuario ?? "-")</td>
                            <td><span style="color:@colorEstado; font-weight:600;">@v.estado</span></td>
                            <td style="white-space:nowrap;">
                                <a asp-controller="Venta" asp-action="Detalle" asp-route-id="@v.idVenta"
                                   style="padding:4px 10px; border-radius:4px; text-decoration:none; font-size:0.85rem; color:#fff; background:#304D8A; margin-right:4px; display:inline-block;">
                                    Detalle
                                </a>
                                @if (v.estado == "Pendiente")
                                {
                                    <form asp-controller="Venta" asp-action="Anular" asp-route-id="@v.idVenta" method="post" style="display:inline;">
                                        <button type="submit"
                                                style="padding:4px 10px; border:none; border-radius:4px; cursor:pointer; font-size:0.85rem; color:#fff; background:#DC3545;"
                                                onclick="return confirm('¿Anular esta venta y restaurar el stock?');">
                                            Anular
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
