@model IEnumerable<AppWeb.Models.Cliente>
@{
    ViewData["Title"] = "Clientes";
    Layout = "_LayoutDashboard";
}

<div id="viewClientes" class="view-container active">
    <div class="view-header" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
        <div>
            <h2>Clientes</h2>
            <div class="breadcrumb">Inicio &gt; <span>Clientes</span></div>
        </div>
        <a asp-controller="Cliente" asp-action="Crear"
           style="background:#304D8A; color:#fff; padding:10px 18px; border-radius:8px; text-decoration:none; font-weight:500; display:inline-flex; align-items:center; gap:8px;">
            <i class="fas fa-user-plus"></i> Nuevo Cliente
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div style="margin-bottom: 15px; padding: 10px 15px; border-radius: 6px; background: #d4edda; color: #155724;">
            @TempData["Mensaje"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div style="margin-bottom: 15px; padding: 10px 15px; border-radius: 6px; background: #f8d7da; color: #721c24;">
            @TempData["Error"]
        </div>
    }

    <!-- TARJETAS DE MÉTRICAS -->
    <div class="metrics-row">
        <div class="metric-box">
            <span class="label">Total Clientes</span>
            <span class="value">@Model.Count()</span>
        </div>
        <div class="metric-box">
            <span class="label">Clientes Activos</span>
            <span class="value">@Model.Count(c => c.estado)</span>
        </div>
        <div class="metric-box">
            <span class="label">Con Compras</span>
            <span class="value">@Model.Count(c => c.Ventas.Any())</span>
        </div>
    </div>

    <!-- BUSCADOR -->
    <form asp-controller="Cliente" asp-action="Index" method="get" style="display:flex; gap:10px; margin-bottom:16px; flex-wrap:wrap;">
        <input type="text" name="buscar" value="@ViewBag.Buscar" placeholder="Buscar por nombre, razón social, documento o correo..."
               style="flex:1; min-width:240px; padding:9px 12px; border:1px solid #ced4da; border-radius:6px;" />
        <button type="submit" style="padding:9px 16px; border:none; border-radius:6px; background:#304D8A; color:#fff; cursor:pointer;">
            <i class="fas fa-search"></i> Buscar
        </button>
        @if (!string.IsNullOrWhiteSpace(ViewBag.Buscar as string))
        {
            <a asp-controller="Cliente" asp-action="Index"
               style="padding:9px 16px; border-radius:6px; background:#e2e6ea; color:#333; text-decoration:none; display:inline-flex; align-items:center;">
                Limpiar
            </a>
        }
    </form>

    <!-- TABLA DE CLIENTES -->
    <div class="table-wrapper">
        <table class="data-table" id="clientesTable">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Documento</th>
                    <th>Nombre / Razón Social</th>
                    <th>Email</th>
                    <th>Teléfono</th>
                    <th>Compras</th>
                    <th>Total Gastado</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody id="clientesTableBody">
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" style="text-align:center; padding:20px; color:#6c757d;">
                            No se encontraron clientes registrados.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var cliente in Model)
                    {
                        var totalGastado = cliente.Ventas?.Sum(v => v.total) ?? 0m;
                        var cantCompras = cliente.Ventas?.Count ?? 0;
                        <tr>
                            <td>@cliente.idCliente</td>
                            <td>@cliente.tipoDocumento: @cliente.numeroDocumento</td>
                            <td>
                                <strong>@cliente.nombres</strong>
                                @if (!string.IsNullOrWhiteSpace(cliente.razonSocial) && cliente.razonSocial != cliente.nombres)
                                {
                                    <div style="font-size:0.85rem; color:#6c757d;">@cliente.razonSocial</div>
                                }
                            </td>
                            <td>@cliente.email</td>
                            <td>@cliente.telefono</td>
                            <td>@cantCompras</td>
                            <td>S/ @totalGastado.ToString("N2")</td>
                            <td>
                                @if (cliente.estado)
                                {
                                    <span style="color:#28A745; font-weight:600;">Activo</span>
                                }
                                else
                                {
                                    <span style="color:#FFC107; font-weight:600;">Inactivo</span>
                                }
                            </td>
                            <td style="white-space:nowrap;">
                                <a asp-controller="Cliente" asp-action="Editar" asp-route-id="@cliente.idCliente"
                                   style="padding:4px 10px; border-radius:4px; text-decoration:none; font-size:0.85rem; color:#fff; background:#304D8A; margin-right:4px; display:inline-block;">
                                    Editar
                                </a>
                                <form asp-controller="Cliente" asp-action="CambiarEstado" asp-route-id="@cliente.idCliente" method="post" style="display:inline;">
                                    <button type="submit"
                                            style="padding:4px 10px; border:none; border-radius:4px; cursor:pointer; font-size:0.85rem; color:#fff; background:@(cliente.estado ? "#DC3545" : "#28A745");"
                                            onclick="return confirm('@(cliente.estado ? "¿Desactivar este cliente?" : "¿Activar este cliente?")');">
                                        @(cliente.estado ? "Desactivar" : "Activar")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

