@model AppWeb.Models.Categoria
@{
    ViewData["Title"] = "Nueva Categoría";
    Layout = "_LayoutDashboard";
}

<div id="viewCrearCategoria" class="view-container active">
    <div class="view-header" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
        <div>
            <h2>Nueva Categoría</h2>
            <div class="breadcrumb">
                <a asp-controller="Home" asp-action="Index" style="color:inherit; text-decoration:none;">Inicio</a> &gt;
                <a asp-controller="Categoria" asp-action="Index" style="color:inherit; text-decoration:none;">Categorías</a> &gt;
                <span>Nueva Categoría</span>
            </div>
        </div>
        <a asp-controller="Categoria" asp-action="Index"
           style="background:#6c757d; color:#fff; padding:8px 16px; border-radius:8px; text-decoration:none; font-weight:500; display:inline-flex; align-items:center; gap:8px;">
            <i class="fas fa-arrow-left"></i> Volver
        </a>
    </div>

    <div class="table-wrapper" style="max-width: 650px; padding: 24px;">
        <form asp-controller="Categoria" asp-action="Crear" method="post" autocomplete="off">
            <div asp-validation-summary="All" style="color:#DC3545; margin-bottom:15px;"></div>

            <div style="margin-bottom: 14px;">
                <label asp-for="nombre" style="display:block; font-weight:500; margin-bottom:6px;">Nombre</label>
                <input type="text" asp-for="nombre" placeholder="Ej. Frenos, Filtros, Lubricantes"
                       style="width:100%; padding:10px 12px; border:1px solid #ced4da; border-radius:6px; box-sizing:border-box;" />
            </div>

            <div style="margin-bottom: 20px;">
                <label asp-for="descripcion" style="display:block; font-weight:500; margin-bottom:6px;">Descripción</label>
                <textarea asp-for="descripcion" rows="3" placeholder="Descripción de la categoría..."
                          style="width:100%; padding:10px 12px; border:1px solid #ced4da; border-radius:6px; box-sizing:border-box; font-family:inherit;"></textarea>
            </div>

            <div style="display:flex; gap:10px; justify-content:flex-end;">
                <a asp-controller="Categoria" asp-action="Index"
                   style="padding:10px 18px; border-radius:6px; text-decoration:none; background:#e2e6ea; color:#333; font-weight:500;">
                    Cancelar
                </a>
                <button type="submit"
                        style="padding:10px 20px; border:none; border-radius:6px; background:#304D8A; color:#fff; font-weight:500; cursor:pointer;">
                    <i class="fas fa-save"></i> Guardar Categoría
                </button>
            </div>
        </form>
    </div>
</div>

